{
  "name": "interface-computer-use",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Record-once, replay-many computer-use automation demo",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build --silent && node --test dist/tests/core.test.js dist/tests/integration.test.js",
    "target": "npm run build --silent && node dist/src/target/server.js",
    "discover": "npm run build --silent && node dist/src/cli.js discover",
    "replay": "npm run build --silent && node dist/src/cli.js replay",
    "demo": "npm run build --silent && node dist/src/demo.js",
    "evidence:offline": "npm run build --silent && node dist/scripts/generate-offline-evidence.js",
    "evidence:live": "npm run build --silent && node dist/scripts/generate-live-evidence.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "openai": "^6.6.0",
    "playwright": "^1.55.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2"
  }
}
